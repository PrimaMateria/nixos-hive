{
  inputs,
  cell,
  super,
}: let
  inherit (cell) secrets;
  inherit (inputs) nixpkgs;
in
  nixpkgs.writeTextFile {
    name = "synapse-config.yaml";
    text = builtins.toJSON {
      server_name = "matrix.primamateria.ddns.net";
      public_baseurl = "https://matrix.primamateria.ddns.net/";

      # Answer /.well-known/matrix/server ourselves. Without it remote servers
      # get a 404 and fall back to the SRV/8448 path, which means the
      # federation entrypoint has to stay open forever.
      serve_server_wellknown = true;

      pid_file = "/data/homeserver.pid";
      listeners = [
        {
          port = 8008;
          tls = false;
          type = "http";
          x_forwarded = true;
          resources = [
            {
              names = ["client" "federation"];
              compress = false;
            }
          ];
        }
      ];

      database = {
        name = "psycopg2";
        args = {
          user = secrets.matrix.synapse.postgres_user;
          password = secrets.matrix.synapse.postgres_password;
          dbname = "synapse";
          host = "synapse-db";
        };
      };

      # Single-user server federating into large public rooms: presence is
      # pure overhead here.
      presence.enabled = false;

      report_stats = true;
      log_config = "/matrix.primamateria.ddns.net.log.config";
      media_store_path = "/data/media_store";

      # Forbid public registration
      enable_registration = false;
      registration_shared_secret = secrets.matrix.synapse.registration_shared_secret;

      macaroon_secret_key = secrets.matrix.synapse.macaroon_secret_key;
      form_secret = secrets.matrix.synapse.form_secret;

      # Signing key is autogenerated
      signing_key_path = "/data/primamateria.ddns.net.signing.key";
      trusted_key_servers = [
        {server_name = "matrix.org";}
      ];
      suppress_key_server_warning = true;

      app_service_config_files = [
        "/heisenbridge-registration.yaml"
        "/mautrix-whatsapp-registration.yaml"
        "/mautrix-discord-registration.yaml"
      ];
    };
  }
